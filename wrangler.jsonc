{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pay-system",
  "main": "src/index.js",
  "compatibility_date": "2026-08-07",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "compatibility_flags": ["nodejs_compat"],
  // R2 Bucket 绑定
  "r2_buckets": [
    {
      "binding": "PAY_BUCKET",
      "bucket_name": "pay-system-data"
    }
  ],
  // Cron Trigger — 每小时清理过期订单
  "triggers": {
    "crons": ["0 * * * *"]
  }
}